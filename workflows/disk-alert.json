{
  "name": "Disk Alert \u2014 High Usage",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "da000002-0000-0000-0000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:8765/api/status",
        "options": {}
      },
      "id": "da000002-0000-0000-0000-000000000002",
      "name": "Get Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst disks = Array.isArray(raw.disks) ? raw.disks : (Array.isArray(raw) ? raw : []);\nreturn disks.map(d => ({ json: d }));"
      },
      "id": "da000002-0000-0000-0000-000000000003",
      "name": "Split Disks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-da-001",
              "leftValue": "={{ $json.pct }}",
              "rightValue": 85,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "da000002-0000-0000-0000-000000000004",
      "name": "Over 85%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8085/alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Title",
              "value": "Disk Warning"
            },
            {
              "name": "Priority",
              "value": "high"
            },
            {
              "name": "Tags",
              "value": "warning,disk"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "=Disk {{ $json.device }} is at {{ $json.pct }}% usage on ksgcohub",
        "options": {}
      },
      "id": "da000002-0000-0000-0000-000000000005",
      "name": "Send Disk Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -100
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Status": {
      "main": [
        [
          {
            "node": "Split Disks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Disks": {
      "main": [
        [
          {
            "node": "Over 85%?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Over 85%?": {
      "main": [
        [
          {
            "node": "Send Disk Alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}