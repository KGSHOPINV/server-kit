# ============================================================
# SUPABASE SELF-HOSTED - ENVIRONMENT VARIABLES
# Copy this to .env and change ALL values below
# ============================================================

# --- Database ---
POSTGRES_PASSWORD=your-super-secret-password-change-me

# --- JWT (generate at https://supabase.com/docs/guides/self-hosting#api-keys) ---
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# --- API Keys (generate these from JWT_SECRET) ---
# Use: https://supabase.com/docs/guides/self-hosting#api-keys
ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key

# --- URLs ---
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
